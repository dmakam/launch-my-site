# Copy this file to .env and fill in only the lines for the route you agreed. Never paste these values into a chat.
# Website address (all routes)
SITE_URL=https://theirdomain.com

# Control panel API token (deploy_cpanel.py)
CPANEL_HOST=
CPANEL_USER=
CPANEL_TOKEN=
# CPANEL_PORT=2083

# SFTP (deploy_sftp.py)
SFTP_HOST=
SFTP_USER=
SFTP_KEY_FILE=./deploy_key
# SFTP_PASSWORD=   (only if the host does not support keys)
# SFTP_PORT=22
REMOTE_DIR=public_html

# WordPress Application Password (publish_wordpress.py)
WP_SITE=https://theirdomain.com
WP_USER=
WP_APP_PASSWORD=
